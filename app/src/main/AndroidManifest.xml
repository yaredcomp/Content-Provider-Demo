<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Custom permissions protecting the ContentProvider (Teaching requirement) -->
    <permission
        android:name="com.example.campusdirectory.READ_CONTACTS"
        android:protectionLevel="normal" />
    <permission
        android:name="com.example.campusdirectory.WRITE_CONTACTS"
        android:protectionLevel="normal" />

    <!-- In-app client uses these permissions to query/write its own provider in ShareDemoScreen -->
    <uses-permission android:name="com.example.campusdirectory.READ_CONTACTS" />
    <uses-permission android:name="com.example.campusdirectory.WRITE_CONTACTS" />

    <application
        android:name=".CampusApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- CONTENT PROVIDER: Exposes contacts to other applications & system clients via URIs -->
        <provider
            android:name=".provider.CampusContactProvider"
            android:authorities="com.example.campusdirectory"
            android:exported="true"
            android:readPermission="com.example.campusdirectory.READ_CONTACTS"
            android:writePermission="com.example.campusdirectory.WRITE_CONTACTS" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
